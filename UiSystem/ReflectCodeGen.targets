<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup>
    <ReflectionSources Include="$(ProjectDir)**\IUIElement.cpp" Exclude="$(ProjectDir)**\*.generated.cpp" />
  </ItemGroup>


  <PropertyGroup>
  <ReflectGenDir>C:\Users\dongd\gitproject\GameEngine\Include\ReflectionFile</ReflectGenDir>
  </PropertyGroup>


 <ItemDefinitionGroup>
      <ClCompile>
        <PreprocessorDefinitions>%(PreprocessorDefinitions)</PreprocessorDefinitions>
        <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      </ClCompile>
    </ItemDefinitionGroup>



  <Target Name="RunCodeGenerator" BeforeTargets="ClCompile">
    <Message Text="[Reflection] Running CodeGenerator..." Importance="high" />
    <Exec Command="echo Starting code generation..." />
    <Exec Command="mkdir $(ProjectDir)Generated" Condition="!Exists('$(ProjectDir)Generated')" />

    <Exec WorkingDirectory="C:\Users\dongd\gitproject\GameEngine\Include\ReflectionFile"
      Command="&quot;$(SolutionDir)CodeGenerator.exe&quot; --outdir &quot;$(ProjectDir)Generated&quot; &quot;%(ReflectionSources.FullPath)&quot; -- -x c++ -std=c++20 -D__clang__ -I&quot;$(SolutionDir)Include&quot; -I&quot;$(SolutionDir)Include\ReflectionFile&quot; -I&quot;$(ProjectDir)Core&quot; -I&quot;$(ProjectDir)CoreAsset&quot; -I&quot;$(ProjectDir)Render&quot; -I&quot;$(ProjectDir)ReflectSystem&quot; -I&quot;$(ProjectDir)D3DGpuResourceManager&quot; -I&quot;$(ProjectDir)CoreMath&quot; -I&quot;C:\Users\dongd\gitproject\GameEngine&quot;  -I&quot;C:\Users\dongd\gitproject\GameEngine\D3DGpuResourceManager&quot; -I&quot;C:\Users\dongd\gitproject\GameEngine\ReflectSystem&quot; -I&quot;C:\Users\dongd\gitproject\GameEngine\Core&quot; -I&quot;C:\Users\dongd\gitproject\GameEngine\RenderSystem&quot; -I&quot;C:\Users\dongd\gitproject\GameEngine\Logger&quot;"
      StandardOutputImportance="high"
      StandardErrorImportance="high"
      Condition="Exists('%(ReflectionSources.FullPath)')" />
    <ItemGroup>
      <ClCompile>
        <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      </ClCompile>
    </ItemGroup>

    <ItemGroup>
        <ClCompile
      Include="@(ReflectionSources->'$(ReflectGenDir)\%(Filename).generated.cpp')"
      Condition="Exists('%(Identity)')" />    </ItemGroup>


  </Target>

</Project>