<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <CodeGenStampDir>$(ProjectDir)CodeGenStamp\</CodeGenStampDir>
        <DepDir>$(ProjectDir)dep\</DepDir>
        <!-- 네가 쓰는 긴 Clang 인자들을 한 곳에 모아 관리 (필요 시 수정) -->
        <CodeGenClangArgs>-x c++ -std=c++20 -D__clang__ -DD3DX -D__clang_major__=20 -D__clang_minor__=0 -D__clang_patchlevel__=0 -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH -I"$(SolutionDir)Include" -I"$(SolutionDir)Include\ReflectionFile" -I"$(ProjectDir)Core" -I"$(ProjectDir)CoreAsset" -I"$(ProjectDir)Render" -I"$(ProjectDir)ReflectSystem" -I"$(ProjectDir)D3DGpuResourceManager" -I"$(ProjectDir)CoreMath" -I"C:\Users\dongd\gitproject\GameEngine" -I"C:\Users\dongd\gitproject\GameEngine\D3DGpuResourceManager" -I"C:\Users\dongd\gitproject\GameEngine\ReflectSystem" -I"C:\Users\dongd\gitproject\GameEngine\Core" -I"C:\Users\dongd\gitproject\GameEngine\RenderSystem" -I"C:\Users\dongd\gitproject\GameEngine\Logger" -I"C:\Users\dongd\gitproject\GameEngine\UiSystem" -I"C:\Users\dongd\gitproject\GameEngine\Include\Component" -I"C:\Users\dongd\gitproject\GameEngine\Utility" -I"C:\Users\dongd\gitproject\GameEngine\BinaryReaderWriter" -I"C:\Users\dongd\gitproject\GameEngine\CoreAsset" -I"C:\Users\dongd\gitproject\GameEngine\EditorDirector" -I"C:\Users\dongd\gitproject\GameEngine\Include\EditorDirector" -I"C:\Users\dongd\gitproject\GameEngine\PhysicalFileSystem" -I"C:\Users\dongd\gitproject\GameEngine\LogicalFileSystem" -I"C:\Users\dongd\gitproject\GameEngine\ImportModule" -I"C:\Users\dongd\gitproject\GameEngine\SystemInitializer"</CodeGenClangArgs>
         <CodeGenExePath>$(SolutionDir)CodeGenerator.exe</CodeGenExePath>
    </PropertyGroup>

    <ItemGroup>
        <ReflectionSources Include="$(ProjectDir)**\*.cpp"
                            Exclude="$(ProjectDir)**\*.generated.cpp"/>
    </ItemGroup>

    <ItemGroup>
        <ReflectionSources Update="@(ReflectionSources)">
            <GenCpp>$(ProjectDir)Generated\%(Filename).generated.cpp</GenCpp>
            <GenH>  $(ProjectDir)Generated\%(Filename).generated.h</GenH>
            <Stamp>$(CodeGenStampDir)%(Filename).stamp</Stamp>
            <Deps>  $(DepDir)%(Filename).deps</Deps>
        </ReflectionSources>
    </ItemGroup>

    <Target Name="EchoSources" BeforeTargets="ClCompile">
        <Message Text="Source: %(ReflectionSources.FullPath)" Importance="High"/>
        <Message Text="  -> GenCpp: %(ReflectionSources.GenCpp)" Importance="High"/>
        <Message Text="  -> GenH:   %(ReflectionSources.GenH)"   Importance="High"/>
    </Target>

    <Target Name="EnsureGenDirs" BeforeTargets="DiscoverDeps;RunCodeGeneratorBatch">
        <MakeDir Directories="$(ProjectDir)Generated" Condition="!Exists('$(ProjectDir)Generated')"/>
        <MakeDir Directories="$(CodeGenStampDir)" Condition="!Exists('$(CodeGenStampDir)')"/>
        <MakeDir Directories="$(DepDir)"  Condition="!Exists('$(DepDir)')" />
    </Target>

    <!-- 1) 🔎 의존성 발견(deps-only) : 소스나 옵션이 바뀌면 deps 재작성 -->
    <Target Name="DiscoverDeps"
            DependsOnTargets="EnsureGenDirs"
            Inputs="@(ReflectionSources->'%(FullPath)');$(SolutionDir)CodeGenerator.exe;$(MSBuildAllProjects)"
            Outputs="@(ReflectionSources->'%(Deps)')">

        <Exec Command="&quot;$(SolutionDir)CodeGenerator.exe&quot; --deps-only --outdeps &quot;$([System.String]::Copy('%(ReflectionSources.Deps)').Trim())&quot; &quot;%(ReflectionSources.FullPath)&quot; -- $(CodeGenClangArgs)"
              StandardOutputImportance="Low"
              StandardErrorImportance="High" />
    </Target>

    <!-- 2) 📥 deps 로드: 각 .deps를 '해당 cpp'와 배칭해서 읽고 Owner 메타데이터를 부여 -->
    <Target Name="LoadDeps" DependsOnTargets="DiscoverDeps">
        <Message Text="Loading dependencies..." Importance="High"/>
        <!-- 1) 각 deps 파일에 Owner(원본 cpp) 메타데이터를 먼저 부여 -->
        <ItemGroup>
            <_DepsFile Include="%(ReflectionSources.Deps)"
                    Condition="Exists('%(ReflectionSources.Deps)')">
            <Owner>%(ReflectionSources.FullPath)</Owner>
            </_DepsFile>
        </ItemGroup>

        <!-- 2) 파일별로 deps 라인을 읽고 -->
        <ReadLinesFromFile File="%(_DepsFile.FullPath)">
            <Output TaskParameter="Lines" ItemName="_OneDepsLines"/>
        </ReadLinesFromFile>

        <!-- 3) 읽은 라인들을 AllDeps로 만들면서, Owner를 _DepsFile.Owner에서 복사 -->
        <CreateItem Include="@(_OneDepsLines)"
                    AdditionalMetadata="Owner=%(_DepsFile.Owner)">
            <Output TaskParameter="Include" ItemName="AllDeps"/>
        </CreateItem>

        <Message Text="LoadDeps batch: %(_DepsFile.FullPath) -> Owner=%(_DepsFile.Owner)" Importance="High"/>
        <Message Text="AllDeps Item=%(AllDeps.Identity), Owner=%(AllDeps.Owner)" Importance="High" />
    </Target>

    <!-- 3) 🔄 코드 생성: 각 소스파일별로 개별 처리 -->
    <Target Name="RunCodeGeneratorBatch" DependsOnTargets="LoadDeps" BeforeTargets="ClCompile">
        <!-- 각 ReflectionSources에 대해 개별적으로 MSBuild 재귀 호출 -->
        <MSBuild Projects="$(MSBuildThisFileFullPath)"
                 Targets="RunCodeGeneratorSingle"
                 Properties="SourceFile=%(ReflectionSources.FullPath);StampFile=%(ReflectionSources.Stamp);GenCppFile=%(ReflectionSources.GenCpp);GenHFile=%(ReflectionSources.GenH);DepsFile=%(ReflectionSources.Deps)"
                 BuildInParallel="false" />
    </Target>

    <!-- 4) 🎯 개별 소스 파일 처리 (새로운 MSBuild 인스턴스에서 실행) -->
    <Target Name="RunCodeGeneratorSingle">
        <!-- deps 파일이 존재하면 내용 읽기 -->
        <ReadLinesFromFile File="$(DepsFile)" 
                           Condition="Exists('$(DepsFile)')">
            <Output TaskParameter="Lines" ItemName="CurrentDeps"/>
        </ReadLinesFromFile>

        <!-- 입력 파일들 준비 -->
        <ItemGroup>
            <AllInputFiles Include="$(SourceFile)" />
            <AllInputFiles Include="@(CurrentDeps)" Condition="Exists('%(Identity)')" />
        </ItemGroup>

        <!-- 재생성 필요 여부 판단을 위한 파일 시간 비교 -->
        <PropertyGroup>
            <NeedsRegeneration>false</NeedsRegeneration>
        </PropertyGroup>

        <!-- Stamp 파일이 없으면 무조건 생성 -->
        <PropertyGroup Condition="!Exists('$(StampFile)')">
            <NeedsRegeneration>true</NeedsRegeneration>
        </PropertyGroup>

        <!-- Stamp 파일이 있으면 입력 파일들과 시간 비교 -->
        <ItemGroup Condition="Exists('$(StampFile)')">
            <StampFiles Include="$(StampFile)" />
        </ItemGroup>

        <!-- MSBuild의 내장 기능을 사용하여 최신성 체크 -->
        <PropertyGroup Condition="Exists('$(StampFile)') and '$(NeedsRegeneration)' != 'true'">
            <StampTime>$([System.IO.File]::GetLastWriteTime('$(StampFile)').Ticks)</StampTime>
        </PropertyGroup>

        <!-- 각 입력 파일이 stamp보다 새로운지 확인 -->
        <PropertyGroup Condition="Exists('$(StampFile)') and '$(NeedsRegeneration)' != 'true'">
            <SourceTime>$([System.IO.File]::GetLastWriteTime('$(SourceFile)').Ticks)</SourceTime>
            <NeedsRegeneration Condition="$(SourceTime) &gt; $(StampTime)">true</NeedsRegeneration>
        </PropertyGroup>

        <!-- 의존성 파일들도 체크 -->
        <PropertyGroup Condition="Exists('$(StampFile)') and '$(NeedsRegeneration)' != 'true'">
            <NeedsRegeneration Condition="$([System.IO.File]::GetLastWriteTime('%(CurrentDeps.Identity)').Ticks) &gt; $(StampTime) and Exists('%(CurrentDeps.Identity)')">true</NeedsRegeneration>
        </PropertyGroup>

        <!-- 디버깅 메시지 -->
        <Message Text="[Gen] Checking: $(SourceFile)" Importance="High" />
        <Message Text="[Gen] Stamp exists: $([System.IO.File]::Exists('$(StampFile)'))" Importance="High" />
        <Message Text="[Gen] Input deps count: @(CurrentDeps->Count())" Importance="High" />
        <Message Text="[Gen] Needs regeneration: $(NeedsRegeneration)" Importance="High" />

        <!-- 코드 생성 실행 -->
        <Exec Command="&quot;$(SolutionDir)CodeGenerator.exe&quot; --outdir &quot;$(ProjectDir)Generated&quot; &quot;$(SourceFile)&quot; -- $(CodeGenClangArgs)"                      
              StandardOutputImportance="High"
              StandardErrorImportance="High"
              Condition="'$(NeedsRegeneration)' == 'true' and Exists('$(SourceFile)')" />

        <Touch Files="$(StampFile)" AlwaysCreate="true" Condition="'$(NeedsRegeneration)' == 'true'" />

        <Message Text="[Gen] Code generation completed for: $(SourceFile)" Importance="High" Condition="'$(NeedsRegeneration)' == 'true'" />
    </Target>

    <!-- 생성된 파일들을 컴파일에 포함 -->
    <ItemGroup>
        <ClCompile Include="$(ProjectDir)Generated\*.generated.cpp" />
        <ClInclude Include="$(ProjectDir)Generated\*.generated.h" />
    </ItemGroup>
            
    <ItemDefinitionGroup>
        <ClCompile>
            <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)Generated;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
        </ClCompile>
    </ItemDefinitionGroup>

</Project>