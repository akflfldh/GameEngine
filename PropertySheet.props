<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup />
  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$(SolutionDir)$(PlatformTarget)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)BinaryReaderWriter;$(SolutionDir)Core;$(SolutionDir)CoreAsset;$(SolutionDir)D3DGpuResourceManager;$(SolutionDir)ImportModule;$(SolutionDir)JsonParserWrapping;$(SolutionDir)Logger;$(SolutionDir)LogicalFileSystem;$(SolutionDir)PhysicalFileSystem;$(SolutionDir)RenderSystem;$(SolutionDir)Utility;$(SolutionDir)Window;$(SolutionDir)Logger\Include;$(SolutionDir)CoreMath;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>